<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Events — Ticketly</title>
  <link rel="stylesheet" href="/style.css">
<style>
  .ai-desc-wrapper { position:relative; }
  .ai-gen-bar {
    display:flex; justify-content:space-between; align-items:center;
    margin-bottom:0.4rem;
  }
  .ai-btn {
    display:inline-flex; align-items:center; gap:0.3rem;
    padding:0.25rem 0.65rem; border-radius:20px;
    background:linear-gradient(135deg,var(--violet),var(--purple-mid));
    color:white; font-size:0.72rem; font-weight:600; letter-spacing:0.3px;
    border:none; cursor:pointer; transition:opacity 0.2s; font-family:'DM Sans',sans-serif;
  }
  .ai-btn:hover { opacity:0.88; }
  .ai-btn:disabled { opacity:0.45; cursor:not-allowed; }
  .ai-generating-overlay {
    position:absolute; inset:0; background:rgba(255,255,255,0.85);
    display:none; align-items:center; justify-content:center; gap:0.6rem;
    border-radius:8px; font-size:0.82rem; color:var(--violet); font-weight:500;
    z-index:2;
  }
  .ai-generating-overlay.show { display:flex; }
</style>
</head>
<body>

<div id="token-expiry-bar"></div>

<nav>
  <a href="/" class="nav-logo">Ticket<span>Guard</span></a>
  <div class="nav-links">
    <a href="/">Events</a>
    <a href="/organizer" class="active">My Events</a>
  </div>
  <div class="nav-right"></div>
</nav>

<div class="container page">
  <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
    <div>
      <div class="page-eyebrow">// Organizer Dashboard</div>
      <h1 class="page-title">My Events</h1>
      <p class="page-subtitle">Create, publish and manage your events</p>
    </div>
    <button class="btn btn-primary" onclick="openModal('create-modal')">+ Create Event</button>
  </div>

  <!-- FILTER -->
  <div class="filter-bar">
    <button class="filter-btn active" onclick="filterEvents('all', this)">All</button>
    <button class="filter-btn" onclick="filterEvents('draft', this)">📝 Draft</button>
    <button class="filter-btn" onclick="filterEvents('published', this)">🟢 Published</button>
    <button class="filter-btn" onclick="filterEvents('completed', this)">✅ Completed</button>
    <button class="filter-btn" onclick="filterEvents('cancelled', this)">❌ Cancelled</button>
  </div>

  <!-- EVENTS LIST -->
  <div id="events-list">
    <% if (!events || events.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">🎭</div>
        <h3>No Events Yet</h3>
        <p>Create your first event to get started.</p>
        <button class="btn btn-primary" onclick="openModal('create-modal')">Create Event</button>
      </div>
    <% } else { %>
      <% events.forEach(e => { 
        const cats = e.seatCategories || e.categories || [];
        const minPrice = cats.length ? Math.min(...cats.map(c => Number(c.price))) : 0;
        const totalSeats = e.totalSeats || e.total_seats || 0;
      %>
      <div class="booking-item" data-status="<%= e.status %>">
        <div class="booking-item-accent"></div>
        <div class="booking-item-body">
          <div style="flex:1;">
            <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.5rem; flex-wrap:wrap;">
              <% 
                const statusBadges = {
                  draft: '<span class="status-badge">📝 Draft</span>',
                  published: '<span class="status-badge status-published">🟢 Published</span>',
                  completed: '<span class="status-badge status-completed">✅ Completed</span>',
                  cancelled: '<span class="status-badge status-cancelled">❌ Cancelled</span>'
                };
              %>
              <%- statusBadges[e.status] || `<span class="status-badge">${e.status}</span>` %>
              <span class="event-category-tag" style="margin:0;"><%= e.category || 'Event' %></span>
            </div>
            <div class="booking-event-name"><%= e.title %></div>
            <div class="booking-meta">
              📅 <%= new Date(e.eventDate).toLocaleDateString() %> · 🕐 <%= new Date(e.eventDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %><br>
              📍 <%= e.venue || 'TBA' %> · 🪑 <%= totalSeats %> seats · 💰 From ₹<%= minPrice %>
            </div>
            <% if (cats.length) { %>
              <div style="display:flex; gap:0.4rem; flex-wrap:wrap; margin-top:0.6rem;">
                <% cats.forEach(cat => { %>
                  <span style="font-size:0.7rem; padding:0.15rem 0.5rem; background:var(--surface); border:1px solid var(--border); border-radius:3px; color:var(--text2); font-family:'DM Mono',monospace;">
                    <%= cat.categoryName || cat.name %> · ₹<%= cat.price %>
                  </span>
                <% }) %>
              </div>
            <% } %>
          </div>
          <div style="display:flex; flex-direction:column; gap:0.5rem; align-items:flex-end; flex-shrink:0;">
            <a href="/event.html?id=<%= e.id %>" class="btn btn-outline btn-sm">View</a>
         <% if (e.status === 'draft') { %>
  <button 
    class="btn btn-primary btn-sm"
    data-id="<%= e.id %>"
    data-title="<%= e.title %>"
    onclick="initPublish(this.dataset.id, this.dataset.title)">
    🚀 Publish
  </button>
<% } %>

<% if (e.status === 'published') { %>
  <button 
    class="btn btn-danger btn-sm"
    data-id="<%= e.id %>"
    data-title="<%= e.title %>"
    onclick="initCancelEvent(this.dataset.id, this.dataset.title)">
    Cancel
  </button>
<% } %>
<button
  class="btn btn-outline btn-sm"
  onclick="openImageUploadModal('<%= e.id %>')"
>
  Images
</button>
          </div>
        </div>
        <div class="booking-item-footer">
          <span style="font-size:0.75rem; color:var(--muted);">Created <%= new Date(e.createdAt).toLocaleDateString() %></span>
          <span style="font-size:0.75rem; color:var(--muted);"><%= cats.length %> categor<%= cats.length === 1 ? 'y' : 'ies' %></span>
        </div>
      </div>
      <% }) %>
    <% } %>
  </div>
</div>

<!-- CREATE EVENT MODAL -->
<div class="modal-overlay" id="create-modal">
  <div class="modal" style="max-width:640px; max-height:88vh; overflow-y:auto;">
    <div class="modal-icon">🎭</div>
    <h2 class="modal-title">Create New Event</h2>
    <p class="modal-subtitle">Fill in the details and define your seating layout</p>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
      <div class="form-group" style="grid-column:1/-1;">
        <label>Event Title *</label>
        <input type="text" id="ce-title" placeholder="Arijit Singh Live 2025" />
      </div>
      <div class="form-group">
        <label>Venue *</label>
        <input type="text" id="ce-venue" placeholder="DY Patil Stadium, Mumbai" />
      </div>
      <div class="form-group">
        <label>Date & Time *</label>
        <input type="datetime-local" id="ce-date" />
      </div>
      <div class="form-group" style="grid-column:1/-1;">
        <label>Category *</label>
        <select id="ce-category">
          <option value="Music">🎵 Music</option>
          <option value="Sports">🏆 Sports</option>
          <option value="Comedy">😄 Comedy</option>
          <option value="Theatre">🎭 Theatre</option>
          <option value="Conference">💼 Conference</option>
          <option value="Other">📌 Other</option>
        </select>
      </div>

      <!-- AI DESCRIPTION -->
      <div class="form-group" style="grid-column:1/-1;">
        <div class="ai-gen-bar">
          <label style="margin:0;">Description</label>
          <button class="ai-btn" id="ai-desc-btn" onclick="generateDescription()">
            ✨ Generate with AI
          </button>
        </div>
        <div class="ai-desc-wrapper">
          <textarea id="ce-desc" rows="4" placeholder="Describe your event to attract more attendees... or let AI write it for you."></textarea>
          <div class="ai-generating-overlay" id="ai-overlay">
            <span class="spinner"></span> AI is writing your description...
          </div>
        </div>
        <div style="font-size:0.72rem; color:var(--muted); margin-top:0.3rem;">
          💡 Fill in title, venue and category first for a better AI description
        </div>
      </div>
    </div>

    <div class="divider"></div>
    <p style="font-size:0.72rem; color:var(--muted); letter-spacing:1px; text-transform:uppercase; font-weight:600; margin-bottom:0.75rem;">Seating Categories</p>

    <div id="cat-container">
      <div class="cat-entry" style="background:var(--off); border:1px solid var(--border); border-radius:8px; padding:1rem; margin-bottom:0.75rem;">
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.6rem; margin-bottom:0.6rem;">
          <div class="form-group" style="margin:0;"><label>Name</label><input class="cat-name" type="text" placeholder="VIP" /></div>
          <div class="form-group" style="margin:0;"><label>Price (₹)</label><input class="cat-price" type="number" placeholder="5000" /></div>
          <div class="form-group" style="margin:0;"><label>Seats/Row</label><input class="cat-spr" type="number" placeholder="10" /></div>
        </div>
        <div class="form-group" style="margin:0;"><label>Rows (comma separated)</label><input class="cat-rows" type="text" placeholder="A, B, C" /></div>
      </div>
    </div>
    <button class="btn btn-ghost btn-sm" onclick="addCat()" style="margin-bottom:1rem; color:var(--violet);">+ Add Category</button>

    <div id="create-error" style="display:none;" class="info-box info-box-red"></div>

    <div class="modal-actions">
      <button class="btn btn-primary btn-full" id="create-btn" onclick="submitCreateEvent()">Create Event</button>
      <button class="btn btn-outline" onclick="closeModal('create-modal')">Cancel</button>
    </div>
  </div>
</div>

<!-- PUBLISH MODAL -->
<div class="modal-overlay" id="publish-modal">
  <div class="modal">
    <div class="modal-icon">🚀</div>
    <h2 class="modal-title">Publish Event</h2>
    <p class="modal-subtitle" id="publish-subtitle"></p>
    <div class="info-box info-box-purple" style="margin-bottom:1rem;">
      Once published, the event will be visible to all users and tickets can be booked immediately.
    </div>
    <div class="modal-actions">
      <button class="btn btn-primary btn-full" id="publish-btn">Publish Now</button>
      <button class="btn btn-outline" onclick="closeModal('publish-modal')">Cancel</button>
    </div>
  </div>
</div>

<!-- CANCEL EVENT MODAL -->
<div class="modal-overlay" id="cancel-event-modal">
  <div class="modal">
    <div class="modal-icon" style="background:#fef2f2;">⚠️</div>
    <h2 class="modal-title">Cancel Event</h2>
    <p class="modal-subtitle" id="cancel-event-subtitle"></p>
    <div class="info-box info-box-red" style="margin-bottom:1rem;">
      This will cancel all confirmed bookings and trigger refunds. This cannot be undone.
    </div>
    <div class="modal-actions">
      <button class="btn btn-danger-filled btn-full" id="cancel-event-btn">Yes, Cancel Event</button>
      <button class="btn btn-outline" onclick="closeModal('cancel-event-modal')">Go Back</button>
    </div>
  </div>
</div>
<div class="modal-overlay" id="image-upload-modal">

  <div class="modal">

    <div class="modal-icon">🖼</div>

    <h2 class="modal-title">
      Upload Event Images
    </h2>

    <p class="modal-subtitle">
      Add banners and gallery images for your event
    </p>

    <div class="form-group">

      <label>Select Images</label>

      <input
        type="file"
        id="event-images-input"
        multiple
        accept="image/*"
      />

    </div>

    <div
      id="image-preview-grid"
      style="
        display:grid;
        grid-template-columns:repeat(auto-fill,minmax(90px,1fr));
        gap:0.75rem;
        margin-top:1rem;
      "
    ></div>

    <div class="modal-actions">

      <button
        class="btn btn-primary btn-full"
        id="upload-images-btn"
      >
        Upload Images
      </button>

      <button
        class="btn btn-outline"
        onclick="closeModal('image-upload-modal')"
      >
        Cancel
      </button>

    </div>

  </div>

</div>

<script src="/utils.js"></script>

<script>
let currentFilter = 'all';
let selectedEventIdForImages = null;

function filterEvents(filter, btn) {
  currentFilter = filter;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  const items = document.querySelectorAll('.booking-item');
  items.forEach(item => {
    const status = item.getAttribute('data-status');
    item.style.display = (filter === 'all' || status === filter) ? 'block' : 'none';
  });
}

// ── PUBLISH ──
function initPublish(eventId, title) {
  document.getElementById('publish-subtitle').textContent = `Ready to go live: "${title}"`;
  const btn = document.getElementById('publish-btn');
  btn.onclick = () => publishEvent(eventId);
  openModal('publish-modal');
}

async function publishEvent(eventId) {
  const btn = document.getElementById('publish-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Publishing...';
  try {
    await api.patch(`/events/${eventId}/publish`);
    toast('Event published! 🚀', 'success');
    closeModal('publish-modal');
    location.reload();
  } catch (err) {
    toast(err.message, 'error');
  } finally {
    btn.disabled = false; btn.textContent = 'Publish Now';
  }
}

// ── CANCEL EVENT ──
function initCancelEvent(eventId, title) {
  document.getElementById('cancel-event-subtitle').textContent = `Cancel "${title}"?`;
  const btn = document.getElementById('cancel-event-btn');
  btn.onclick = () => cancelEvent(eventId);
  openModal('cancel-event-modal');
}

async function cancelEvent(eventId) {
  const btn = document.getElementById('cancel-event-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Cancelling...';
  try {
    await api.patch(`/events/${eventId}/cancel`);
    toast('Event cancelled', 'success');
    closeModal('cancel-event-modal');
    location.reload();
  } catch (err) {
    toast(err.message, 'error');
  } finally {
    btn.disabled = false; btn.textContent = 'Yes, Cancel Event';
  }
}

// ── CREATE EVENT ──
async function generateDescription() {
  const title = document.getElementById('ce-title').value.trim();
  const venue = document.getElementById('ce-venue').value.trim();
  const category = document.getElementById('ce-category').value;
  if (!title || !venue || !category) {
    toast('Fill in title, venue and category first', 'error');
    return;
  }
  const btn = document.getElementById('ai-desc-btn');
  const overlay = document.getElementById('ai-overlay');
  btn.disabled = true;
  overlay.classList.add('show');
  try {
    const data = await api.post('/ai/generate-description', { title, venue, category });
    console.log(data);
    document.getElementById('ce-desc').value = data.description.description;
    toast('Description generated! ✨', 'success');
  } catch (err) {
    toast(err.message, 'error');
  } finally {
    btn.disabled = false;
    overlay.classList.remove('show');
  }
}

function addCat() {
  const container = document.getElementById('cat-container');
  const entry = document.createElement('div');
  entry.className = 'cat-entry';
  entry.style.background = 'var(--off)';
  entry.style.border = '1px solid var(--border)';
  entry.style.borderRadius = '8px';
  entry.style.padding = '1rem';
  entry.style.marginBottom = '0.75rem';
  entry.innerHTML = `
    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.6rem; margin-bottom:0.6rem;">
      <div class="form-group" style="margin:0;"><label>Name</label><input class="cat-name" type="text" placeholder="VIP" /></div>
      <div class="form-group" style="margin:0;"><label>Price (₹)</label><input class="cat-price" type="number" placeholder="5000" /></div>
      <div class="form-group" style="margin:0;"><label>Seats/Row</label><input class="cat-spr" type="number" placeholder="10" /></div>
    </div>
    <div class="form-group" style="margin:0;"><label>Rows (comma separated)</label><input class="cat-rows" type="text" placeholder="A, B, C" /></div>
  `;
  container.appendChild(entry);
}

function openImageUploadModal(eventId){

  selectedEventIdForImages = eventId;

  document.getElementById('event-images-input').value = '';

  document.getElementById('image-preview-grid').innerHTML = '';

  openModal('image-upload-modal');
}

async function submitCreateEvent() {
  const title = document.getElementById('ce-title').value.trim();
  const venue = document.getElementById('ce-venue').value.trim();
  const date = document.getElementById('ce-date').value;
  const category = document.getElementById('ce-category').value;
  const desc = document.getElementById('ce-desc').value.trim();
  if (!title || !venue || !date || !category) {
    document.getElementById('create-error').style.display = 'block';
    document.getElementById('create-error').innerHTML = 'Please fill in all required fields.';
    return;
  }
  const cats = [];
  document.querySelectorAll('.cat-entry').forEach(entry => {
    const name = entry.querySelector('.cat-name').value.trim();
    const price = Number(entry.querySelector('.cat-price').value);
    const spr = Number(entry.querySelector('.cat-spr').value);
    const rows = entry.querySelector('.cat-rows').value.trim();
    if (name && price > 0 && spr > 0 && rows) {
      cats.push({ categoryName: name, price, seatsPerRow: spr, rows: rows.split(',').map(r => r.trim()) });
    }
  });
  if (!cats.length) {
    document.getElementById('create-error').style.display = 'block';
    document.getElementById('create-error').innerHTML = 'Add at least one seating category.';
    return;
  }
  const btn = document.getElementById('create-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Creating...';
  try {
    await api.post('/events', {
      title, venue, eventDate: new Date(date).toISOString(), category, description: desc, seatCategories: cats
    });
    toast('Event created! 🎭', 'success');
    closeModal('create-modal');
    // reset form
    document.getElementById('ce-title').value = '';
    document.getElementById('ce-venue').value = '';
    document.getElementById('ce-date').value = '';
    document.getElementById('ce-category').value = 'Music';
    document.getElementById('ce-desc').value = '';
    document.getElementById('cat-container').innerHTML = document.querySelector('.cat-entry').outerHTML;
    document.getElementById('create-error').style.display = 'none';
    location.reload();
  } catch (err) {
    document.getElementById('create-error').style.display = 'block';
    document.getElementById('create-error').innerHTML = err.message;
  } finally {
    btn.disabled = false;
    btn.textContent = 'Create Event';
  }
}

document
  .getElementById('event-images-input')
  .addEventListener('change', function(e){

    const grid = document.getElementById('image-preview-grid');

    grid.innerHTML = '';

    const files = [...e.target.files];

    files.forEach(file => {

      const reader = new FileReader();

      reader.onload = function(ev){

        const img = document.createElement('img');

        img.src = ev.target.result;

        img.style.width = '100%';
        img.style.height = '90px';
        img.style.objectFit = 'cover';
        img.style.borderRadius = '8px';
        img.style.border = '1px solid var(--border)';

        grid.appendChild(img);
      };

      reader.readAsDataURL(file);

    });

});
document
  .getElementById('upload-images-btn')
  .addEventListener('click', async () => {

    const input = document.getElementById('event-images-input');

    if(!input.files.length){

      toast('Select at least one image', 'warning');

      return;
    }

    const btn = document.getElementById('upload-images-btn');

    btn.disabled = true;

    btn.innerHTML = '<span class="spinner"></span> Uploading...';

    try{

      const formData = new FormData();

      [...input.files].forEach(file => {

        formData.append('images', file);

      });

      await fetch(`/api/events/${selectedEventIdForImages}/images`, {

        method: 'POST',

        headers: {
          Authorization: `Bearer ${localStorage.getItem('token')}`
        },

        body: formData

      });

      toast('Images uploaded successfully!', 'success');

      closeModal('image-upload-modal');

      location.reload();

    }catch(err){

      toast('Failed to upload images', 'error');

    }finally{

      btn.disabled = false;

      btn.textContent = 'Upload Images';
    }

});
</script>

</body>
</html>
