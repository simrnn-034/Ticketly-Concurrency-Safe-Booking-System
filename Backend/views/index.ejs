<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticketly — Live Events</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/utils.js" defer></script>

  <style>
    .hero { padding: 4rem 0 3rem; }
    .hero-title { font-size:clamp(2.5rem,5vw,4rem); }
    .reco-section { padding: 2rem 0; border-top:1px solid var(--border); margin-top:2rem; }
  </style>
</head>
<body>

<%- include('partials/navbar') %>

<div class="container">
  <div class="hero">
    <div class="hero-eyebrow">// Concurrency-Safe Ticketing</div>
    <h1 class="hero-title">Book your seat.<br><em>Instantly.</em></h1>

    <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
      <a href="#events" class="btn btn-primary">Browse Events</a>

      <% if (user) {  %>
        <a href="/bookings" class="btn btn-outline">My Bookings</a>
        <% if (user.role === 'organizer') { %>
          <a href="/organizer" class="btn btn-primary">Create Event</a>
        <% } %>
      <% } else { %>
        <a href="/auth" class="btn btn-outline">Get Started</a>
      <% } %>
    </div>
  </div>
</div>

<% if (user && recommendations && recommendations.length) { %>
<div class="container">
  <div class="reco-section">

    <div class="reco-header">
      <h2>Recommended for You</h2>
      <span class="reco-badge">✨ AI Powered</span>
    </div>

    <div class="events-grid">
    
      <% recommendations.forEach(function(r) { %>

        <% const cats = r.seatCategories || r.categories || []; %>
        <%
  const prices = cats.map(function(c) {
    return Number(c.price) || 0;
  });
  const minPrice = prices.length ? Math.min.apply(null, prices) : 0;
%>

        <a href="/event.html?id=<%= r.id %>" class="reco-card">
          <div class="reco-card-accent"></div>

          <div style="padding:1rem;">
              <div class="event-category-tag"><%= r.category || 'Event' %></div>
            <div class="event-title"><%= r.title %></div>
            <div class="event-venue">
              📍 <%= r.venue %>
            </div>
            <div class="event-date">
              📅 <%= new Date(r.eventDate).toLocaleDateString() %>
              . From ₹<%= minPrice %>
            </div>

          </div>

          <% if (r.reason) { %>
            <div class="reco-reason">
              <%= r.reason %>
            </div>
          <% } %>
        </a>

      <% }) %>
    </div>

  </div>
</div>
<% } %>

<!-- ✅ EVENTS (SSR) -->
<div class="container page" id="events">
  <h2 class="page-title">Upcoming Events</h2>

  <div class="events-grid">
    <% if (!events || events.length === 0) { %>
      <p>No events available.</p>
    <% } else { %>

      <% events.forEach(function(e) { 
           const prices = (e.seatCategories || []).map(function(c) { return Number(c.price) || 0; });
           const minPrice = prices.length ? Math.min.apply(null, prices) : 0;
      %>

        <a href="/event.html?id=<%= e.id %>" class="event-card">
          <div class="event-card-accent"></div>
          <% if (e.thumbnail) { %>

  <div class="event-image-wrapper">
    <img
      src="<%= e.thumbnail %>"
      alt="<%= e.title %>"
      class="event-image"
    />
  </div>

<% } else { %>

  <div class="event-thumbnail-fallback">

    <div class="event-thumbnail-overlay"></div>

    <div class="event-thumbnail-content">

      <span class="event-thumbnail-category">
        <%= e.category || 'Event' %>
      </span>

      <div class="event-thumbnail-title">
        <%= e.title %>
      </div>

    </div>

  </div>

<% } %>
          <div class="event-card-body">
            <div class="event-category-tag"><%= e.category || 'Event' %></div>

            <div class="event-title"><%= e.title %></div>

            <div class="event-meta">
              📅 <%= new Date(e.eventDate).toLocaleDateString() %> · 
              📍 <%= e.venue || 'TBA' %>
            </div>

            <div class="event-price">
              From ₹<%= minPrice %>
            </div>
          </div>
        </a>

      <% }); %>

    <% } %>
  </div>
</div>

</body>
</html>